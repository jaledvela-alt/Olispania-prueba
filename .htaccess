# Hostinger (Apache/LiteSpeed): compresión y caché
ErrorDocument 404 /404.html
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType image/avif "access plus 1 year"
  # HTML: siempre se revalida, para que los cambios se vean al publicar
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
DirectoryIndex index.html

# Redirecciones 301 · dominio sin www y URL antiguas de WordPress (2026-11-17)
<IfModule mod_rewrite.c>
RewriteEngine On

# URL antiguas de WordPress con nombre distinto (destino absoluto: un solo salto)
RewriteRule ^beneficios-para-la-salud/?$ https://olispania.es/salud.html [R=301,L,NC]
RewriteRule ^(compania|empresa|instalaciones)/?$ https://olispania.es/ [R=301,L,NC]
RewriteRule ^(tienda|categoria-producto)(/.*)?$ https://olispania.es/productos.html [R=301,L,NC]
RewriteRule ^producto/pepinillos-sabor-anchoa-314ml/?$ https://olispania.es/producto/pepinillos-sabor-anchoa-a-314.html [R=301,L,NC]
RewriteRule ^producto/variantes-314ml/?$ https://olispania.es/producto/variantes-a-314.html [R=301,L,NC]
RewriteRule ^producto/mazorquitas-de-maiz-330-g/?$ https://olispania.es/producto/mazorquitas-de-maiz-v-370.html [R=301,L,NC]
RewriteRule ^programa-de-ayudas-para-la-participacion-en-la-feria-[^/]*/?$ https://olispania.es/noticias.html [R=301,L,NC]
RewriteRule ^olispania/wp-content/uploads/2025/04/OLISPANIA_web_2025\.pdf$ https://olispania.es/catalogo/2026-11-05_Web_catalogo-2026_v1.pdf [R=301,L,NC]
RewriteRule ^(feed|comments/feed|home/feed)/?$ https://olispania.es/ [R=301,L,NC]

# Contenido de prueba de la plantilla antigua: eliminado para siempre (410)
RewriteRule ^(portfolio-2|portfolio-3|portfolio-item|google-maps|category)(/.*)?$ - [G,L,NC]

# Regla general: /pagina/ o /pagina -> /pagina.html, solo si ese .html existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ https://olispania.es/$1.html [R=301,L]

# https y sin www: ya lo fuerza Hostinger a nivel de servidor (comprobado el 2026-11-17).
# No se repite aquí para no arriesgar un bucle detrás del proxy de LiteSpeed.
</IfModule>
